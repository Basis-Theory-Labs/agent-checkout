# Basis Theory TEST tenant. A Management Application with application:create,
# reactor:create, reactor:read and reactor:update. Used by `npm run setup` only.
BT_MANAGEMENT_KEY=

# Browserbase: https://www.browserbase.com/settings
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Any OpenAI-compatible endpoint: OpenAI, xAI (https://api.x.ai/v1),
# OpenRouter (https://openrouter.ai/api/v1), or your own. The agent Reactor
# reads these from its encrypted configuration; rerun `npm run setup` after
# changing them. Calling OpenAI directly, pick a model that accepts
# `max_tokens`: GPT-5 models reject it from the openai-compatible provider.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL=gpt-4.1-mini

# The demo merchant. Deploy ./store anywhere public over HTTPS, or keep this one.
STORE_URL=https://halden-store-cyan.vercel.app

# Written by `npm run setup`.
BT_PRIVATE_API_KEY=
MANDATE_SIGNING_KEY=
INJECT_REACTOR_ID=
AGENT_REACTOR_ID=
CARD_TOKEN_ID=
